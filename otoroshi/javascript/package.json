{
  "name": "otoroshi-ui",
  "version": "1.3.1",
  "description": "React app for otoroshi",
  "private": true,
  "main": "src/backoffice.js",
  "author": "Mathieu ANCELIN",
  "scripts": {
    "clean": "rimraf --glob ../public/javascripts/bundle/*",
    "build:backoffice": "cross-env OTOROSHI_ENTRY=backoffice vite build",
    "build:genericlogin": "cross-env OTOROSHI_ENTRY=genericlogin vite build",
    "build:multilogin": "cross-env OTOROSHI_ENTRY=multilogin vite build",
    "build:simplelogin": "cross-env OTOROSHI_ENTRY=simplelogin vite build",
    "build:faker": "cross-env OTOROSHI_ENTRY=faker vite build",
    "build:elk": "cross-env OTOROSHI_ENTRY=elk vite build",
    "build": "npm run clean && npm run build:backoffice && npm run build:genericlogin && npm run build:multilogin && npm run build:simplelogin && npm run build:faker && npm run build:elk",
    "start": "vite",
    "prettier": "prettier --write --single-quote --trailing-comma es5 --print-width 100 --tab-width 2 --jsx-bracket-same-line \"src/**/*.js\"",
    "licences": "npx legally"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.2.0",
    "@xyflow/react": "12.11.3",
    "antd": "^4.21.4",
    "bcryptjs": "2.4.3",
    "browser-update": "3.3.63",
    "core-js": "^3.50.0",
    "elkjs": "0.12.0",
    "es-symbol": "1.1.2",
    "es6-shim": "0.35.8",
    "faker": "5.1.0",
    "fuzzy": "0.1.3",
    "get-value": "3.0.1",
    "highlight.js": "11.12.0",
    "lodash": "4.18.1",
    "moment": "2.30.1",
    "query-string": "9.1.1",
    "react": "17.0.2",
    "react-color": "^2.19.3",
    "react-dom": "17.0.2",
    "react-query": "^3.39.3",
    "react-router-dom": "5.2.0",
    "react-select": "^5.7.5",
    "react-sparklines": "1.7.0",
    "react-table": "6.11.4",
    "react-tooltip": "5.29.1",
    "recharts": "^2.15.1",
    "set-value": "4.1.0",
    "showdown": "1.9.1",
    "signals-react-safe": "^1.1.2",
    "uuid": "14.0.2",
    "whatwg-fetch": "3.6.20",
    "yaml": "^2.2.2",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "7.0.2",
    "prettier": "2.1.2",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.103.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "react-table": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
